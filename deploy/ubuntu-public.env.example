# Copy these values into the project .env on the Ubuntu host.
# Compose reads .env for port substitution; secrets.env remains separate.
SIEM_BIND_IP=127.0.0.1
LINE_BIND_IP=127.0.0.1
WAF_BIND_IP=127.0.0.1
SIEM_PORT=8000
LINE_PORT=8002
APACHE_WAF_PORT=18080
FLASK_WAF_PORT=18081
DJANGO_WAF_PORT=18082
SIEM_ALLOWED_HOSTS=siem.ponyweng.tw,localhost,127.0.0.1
SIEM_PUBLIC_ORIGIN=https://siem.ponyweng.tw
