}

server {
    listen 443 ssl;
    server_name city.ponyweng.tw;
    ssl_certificate /etc/ssl/cloudflare/ponyweng-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/ponyweng-origin.key;
    location / {
        proxy_pass http://127.0.0.1:18082;
        proxy_set_header Host $host;
