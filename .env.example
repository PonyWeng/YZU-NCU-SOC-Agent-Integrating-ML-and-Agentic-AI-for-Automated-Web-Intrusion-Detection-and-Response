# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ── Elasticsearch ────────────────────────────────────────────
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=your_elasticsearch_password

# ── LINE Bot ─────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
# Comma-separated list of LINE user IDs to notify
LINE_USER_IDS=UserId1,UserId2

# ── OpenAI (only needed for alert_log_to_line_openai.py) ─────
OPENAI_API_KEY=your_openai_api_key

# ── RAG service ──────────────────────────────────────────────
RAG_API_URL=http://localhost:8001/summary

# ── Apache log paths (adjust to your XAMPP installation) ─────
ACCESS_LOG=C:/xampp/apache/logs/access.log
ACCESS2_LOG=C:/xampp/apache/logs/store-logs/access2.log
ACCESS3_LOG=C:/xampp/apache/logs/store-logs/access3.log

# ── ML model ─────────────────────────────────────────────────
MODEL_PATH=MODELS/model_RandomForestClassifier.pkl
