# Local SIEM runs without external credentials.
# Copy to .env only when configuring a new installation.
SIEM_DB_PATH=runtime/siem.sqlite3
ACCESS_LOG=apache-logs/access.log
MODEL_PATH=MODELS/model_RandomForestClassifier.pkl
PROTECTED_SERVER_PORT=80
PROTECTED_SERVER_SERVICE=Apache Web Server (TechMart)

# Optional LINE: allowed administrators and notification recipients.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USER_IDS=
NGROK_AUTHTOKEN=
ENABLE_LINE=false
ENABLE_NGROK=false

# Optional AI and threat intelligence.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
OPENAI_API_KEY=
ABUSEIPDB_API_KEY=
SIEM_ADMIN_USERNAME=admin
# Change this before first startup. It is used only when the users table is empty.
SIEM_ADMIN_PASSWORD=Admin@12345
